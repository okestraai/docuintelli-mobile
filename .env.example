# Copy to .env for local dev. All client env MUST be EXPO_PUBLIC_* to be inlined by Expo.
# In EAS builds, set these via EAS Secrets / eas.json env blocks (never commit real values).

# Consumer API / auth server (mints the JWT the app uses everywhere).
EXPO_PUBLIC_API_BASE_URL=https://docuintelli.com

# Stripe price ids (subscription checkout).
EXPO_PUBLIC_STRIPE_STARTER_PRICE_ID=price_your_starter_monthly
EXPO_PUBLIC_STRIPE_PRO_PRICE_ID=price_your_pro_monthly
EXPO_PUBLIC_STRIPE_STARTER_YEARLY_PRICE_ID=price_your_starter_yearly
EXPO_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=price_your_pro_yearly

# Google OAuth (sign-in) + Drive picker.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_PICKER_API_KEY=your-google-picker-api-key

# RevenueCat public SDK keys (native IAP).
EXPO_PUBLIC_RC_APPLE_KEY=appl_your_revenuecat_apple_key
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_your_revenuecat_google_key

# Business ("firm" network) API base — ADDITIVE + INERT BY DEFAULT. Leave BLANK to keep all firm
# features off (the default, incl. production). Set to the isolated business API origin
# (e.g. https://business.docuintelli.com) to enable in-app firm client-invite acceptance and
# firm signature signing. Mirrors the consumer web's VITE_BUSINESS_API_URL gating.
EXPO_PUBLIC_BUSINESS_API_URL=
